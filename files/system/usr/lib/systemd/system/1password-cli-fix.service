[Unit]
# The 1password-cli RPM's postinstall assigns the onepassword-cli group
# a dynamic gid that differs between the build container (1000) and the
# target host (945). ostree stores file ownership numerically, so
# /usr/bin/op ships with numeric gid 1000, which on the host resolves to
# the primary user's private group — not onepassword-cli. The desktop
# app checks the connecting CLI's effective gid via SO_PEERCRED and
# rejects anything that isn't the runtime onepassword-cli gid, so
# `op` fails with "connection reset".
#
# This unit shadows /usr/bin/op at /usr/local/bin/op with the target's
# actual onepassword-cli gid, sidestepping the numeric-gid drift.
# /usr/local/bin is /var/usrlocal on ostree (writable) and precedes
# /usr/bin in PATH. Runs on every boot so the shadow stays fresh when
# 1password-cli updates via rpm-ostree.
Description=Refresh /usr/local/bin/op with correct group for 1Password CLI integration
ConditionPathExists=/usr/bin/op
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/install -o root -g onepassword-cli -m 2755 /usr/bin/op /usr/local/bin/op

[Install]
WantedBy=multi-user.target
